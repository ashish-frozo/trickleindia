DATABASE_URL=postgresql://pop:replace-local-password@127.0.0.1:55432/pop_demo
POSTGRES_PASSWORD=replace-local-password
DEMO_MODE=true
# Generate a random access code locally, then set its SHA-256 hex digest.
DEMO_ACCESS_CODE_HASH=
ALLOW_DEMO_RESET=true
ALLOW_DEMO_FAULTS=false
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:8080

# Optional production identity. DEMO_MODE=false disables synthetic sign-in.
# Never put client secrets in Flutter defines. This is a public PKCE client.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
AUTH_REDIRECT_URI=

# Optional grounded help-card selection. No provider is contacted unless the user opts in.
# Use an approved HTTPS chat-completions endpoint and provider model; never expose this key in Flutter.
ASSISTANT_ENDPOINT=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
