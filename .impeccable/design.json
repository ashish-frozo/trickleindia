  "narrative": {
    "northStar": "The Programme Workspace and Field Record",
    "overview": "The programme workspace and field record is calm, grounded and exact. Deep forest anchors navigation and important task or balance panels; a warm daylight canvas, white records and quiet sage keep the work legible. Amber identifies waiting money with words and icons.\n\nThe same visual language serves different densities: generous field controls on Android and compact aligned programme records on web. Bundled English and Devanagari lettering, initials and semantic Material controls carry the identity. The shipped system uses no production raster imagery, generated texture or decorative leaf mark.",
    "keyCharacteristics": [
      "Forest anchors and daylight records.",
      "Role-specific density with scalable bilingual typography.",
      "Confirmed money, pending money and principal remain distinct.",
      "Flat surfaces, precise alignment and labelled native controls."
    ],
    "rules": [
      {
        "name": "The Separate Money Rule",
        "body": "Show confirmed savings, pending amounts and principal as separately labelled values; pending never silently joins the confirmed balance.",
        "section": "colors"
      },
      {
        "name": "The Script Continuity Rule",
        "body": "Use the bundled Noto families for English and Hindi, including language controls; allow labels and rows to grow with text scale.",
        "section": "typography"
      },
      {
        "name": "The Flat Record Rule",
        "body": "Routine records use tonal surfaces and fine separators at zero elevation. Reserve modal depth for actual interruption and review.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the real API/controller records and the visible proposal-demo disclosure.",
      "Do pair status colour with an icon and explicit text.",
      "Do keep touch controls at least 48px and mobile primary buttons at least 56px, growing for text.",
      "Do retain all financial labels when tables become stacked records.",
      "Do use initials and semantic Material icons with readable labels."
    ],
    "donts": [
      "Don't fabricate programme metrics, historical activity, session identity or financial totals.",
      "Don't use pale decorative borders as the sole interactive boundary.",
      "Don't replace semantic text or controls with image typography, generated textures or leaf marks.",
      "Don't imply that planned languages, audio, live AI or external WhatsApp are available.",
      "Don't describe this proposal as TUIF approval or completed production accessibility acceptance."
    ]
  }
}
