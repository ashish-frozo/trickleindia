{
  "schemaVersion": 2,
  "identity": {
    "title": "PoP 2.0",
    "status": "Blue/white structural redesign following user feedback"
  },
  "colors": {
    "canvas": "#F5F7FC",
    "surface": "#FFFFFF",
    "primary": "#2456D6",
    "primaryTint": "#EDF2FF",
    "text": "#172B4D",
    "muted": "#526582",
    "border": "#DDE5F1",
    "success": "#24613C",
    "warning": "#80500D",
    "error": "#A12B32",
    "accent": "#FFD5C8",
    "onPrimary": "#FFFFFF",
    "successTint": "#EDF6EE",
    "warningTint": "#FFF2D9",
    "errorTint": "#FCEEF0",
    "forest": "#163EA6",
    "forestMuted": "#DCE7FF",
    "outline": "#7B8DAB",
    "surfaceSoft": "#F0F4FB"
  },
  "fonts": {
    "en": "Noto Sans",
    "hi": "Noto Sans Devanagari",
    "delivery": "Bundle fonts and licence notices; do not depend on startup downloads",
    "weights": [
      400,
      600
    ]
  },
  "typography": {
    "screenTitle": {
      "size": 26,
      "lineHeight": 34,
      "weight": 600
    },
    "sectionTitle": {
      "size": 20,
      "lineHeight": 28,
      "weight": 600
    },
    "body": {
      "size": 17,
      "lineHeight": 26,
      "weight": 400
    },
    "button": {
      "size": 17,
      "lineHeight": 24,
      "weight": 600
    },
    "label": {
      "size": 14,
      "lineHeight": 21,
      "weight": 500
    },
    "amount": {
      "size": 32,
      "lineHeight": 40,
      "weight": 600,
      "tabularNumerals": true
    },
    "portalBody": {
      "size": 14,
      "lineHeight": 21,
      "weight": 400
    }
  },
  "spacing": {
    "unit": 4,
    "page": 20,
    "card": 20,
    "rowGap": 12,
    "sectionGap": 24
  },
  "radius": {
    "card": 16,
    "button": 12,
    "sheet": 24
  },
  "layout": {
    "minimumTouchTarget": 48,
    "primaryButtonMinHeight": 56,
    "portalSidebar": 232,
    "portalContentMaxWidth": 1280
  },
  "motion": {
    "shortMs": 150,
    "normalMs": 220,
    "respectReducedMotion": true
  },
  "viewports": [
    {
      "width": 360,
      "height": 800
    },
    {
      "width": 390,
      "height": 844
    },
    {
      "width": 768,
      "height": 1024
    },
    {
      "width": 1440,
      "height": 1000
    }
  ],
  "contrastRules": {
    "normalTextMinimum": 4.5,
    "largeTextMinimum": 3.0,
    "interactiveBoundaryMinimum": 3.0,
    "decorativeOnly": [
      "accent",
      "border"
    ]
  },
  "notes": [
    "Use a darker border or primary focus indicator for an interactive boundary; the pale border token is for decoration/separation.",
    "Always pair status colour with text and icon.",
    "Heights grow for text scaling; button height is a minimum."
  ]
}
